extends BattleActor
# Hue — the boy in the yellow raincoat.
# His weapon is an umbrella; blunt, defensive, and surprisingly cold.
#
# ATTACK  — Frost Blast:      spends will, AoE frost hits all enemies for reduced damage,
#                              each with a chance to be slowed (frozen 1 turn).
#                              Body part targeted: hits one enemy for full damage, guaranteed freeze.
# ATTACK  — Barrage:          struggle (no will), flails umbrella, random target,
#                              chance to miss, chance to self-hit, no freeze.
# SPECIAL — Encase:           spends 3 will, locks one enemy in ice for 2-4 actor turns.
#                              Their queue slot is pushed down each turn (can't act),
#                              but they take reduced damage while frozen.
# SPECIAL — Desperate Grasp:  sacrifice HP for will (no will for Encase).
# SUPPORT — Ice Shield:       spends 2 will, wraps an ally in frost - dodge for 2 turns.
# SUPPORT — Shiver:           free, only Hue, costs 2 HP, dodge for 1 turn.

const FREEZE_DURATION           = 1
const FROST_BLAST_WILL_COST     = 1
const FROST_BLAST_DMG_MULT      = 0.6
const FROST_BLAST_SLOW_CHANCE   = 0.45
const ENCASE_WILL_COST          = 3
const ENCASE_MIN_TURNS          = 2
const ENCASE_MAX_TURNS          = 4
const ENCASE_DMG_REDUCTION      = 0.5
const SHIELD_WILL_COST          = 2
const SHIELD_DODGE_TURNS        = 2
const SHIVER_HP_COST            = 2
const SHIVER_DODGE_TURNS        = 1
const SELF_HARM_HP_COST         = 3
const SELF_HARM_WILL_RESTORE    = 2


func get_skills() -> Array:
	var has_will = party_member != null and party_member.will > 0
	var can_encase = party_member != null and party_member.will >= ENCASE_WILL_COST
	var can_shield = party_member != null and party_member.will >= SHIELD_WILL_COST
	return [
		{"name": "Frost Blast"     if has_will   else "Barrage",          "key": "attack"},
		{"name": "Encase"          if can_encase  else "Desperate Grasp",  "key": "special"},
		{"name": "Ice Shield"      if can_shield  else "Shiver",           "key": "support"},
	]


func take_turn(target: BattleActor, part: BodyPartData = null) -> void:
	await get_tree().create_timer(0.1).timeout
	tick_status_effects()
	if not is_alive():
		emit_signal("turn_finished")
		return
	if has_status(STATUS_FROZEN):
		print(name, " is frozen and cannot act.")
		spend_turn()
		return
	if party_member != null and party_member.will > 0:
		await _frost_blast(target, part)
	else:
		var manager = get_tree().get_first_node_in_group("battle_manager")
		await struggle_attack(manager.actors, attack_power)


func use_skill(command_key: String, targets: Array) -> void:
	match command_key:
		"special":
			if party_member != null and party_member.will >= ENCASE_WILL_COST:
				var t = targets[0] if not targets.is_empty() else null
				if t == null:
					spend_turn()
					return
				await _encase(t)
			else:
				await _desperate_grasp()
		"support":
			if party_member != null and party_member.will >= SHIELD_WILL_COST:
				var ally = targets[0] if not targets.is_empty() else self
				await _ice_shield(ally)
			else:
				await _shiver()
		_:
			spend_turn()


# --- Skills ---

func _frost_blast(target: BattleActor, part: BodyPartData) -> void:
	if not party_member.spend_will(FROST_BLAST_WILL_COST):
		var manager = get_tree().get_first_node_in_group("battle_manager")
		await struggle_attack(manager.actors, attack_power)
		return

	var manager = get_tree().get_first_node_in_group("battle_manager")
	var enemies = manager.actors.filter(func(a): return a.team == Team.ENEMY and a.is_alive())

	if part != null:
		# Targeted: full damage + guaranteed freeze on single enemy
		var damage := int(attack_power * part.damage_multiplier)
		if part.is_cognitohazard:
			perishing = true
		target.apply_status(STATUS_FROZEN, FREEZE_DURATION)
		print(name, " drives ice into ", target.name, " - frozen solid.")
		await play_attack_animation(target, attack_power, 2.0, damage)
	else:
		# AoE: reduced damage + chance to slow each enemy
		print(name, " blasts a wave of frost across all enemies!")
		for enemy in enemies:
			var dmg = int(attack_power * FROST_BLAST_DMG_MULT)
			enemy.take_damage(dmg, self)
			if randf() < FROST_BLAST_SLOW_CHANCE:
				enemy.apply_status(STATUS_FROZEN, FREEZE_DURATION)
				print(enemy.name, " is slowed by the cold.")
		await get_tree().create_timer(0.5).timeout

	emit_signal("turn_finished")


func _encase(target: BattleActor) -> void:
	party_member.spend_will(ENCASE_WILL_COST)
	var turns = randi_range(ENCASE_MIN_TURNS, ENCASE_MAX_TURNS)
	target.apply_status(STATUS_FROZEN, turns)
	target.apply_status("encased", turns)
	print(name, " encases ", target.name, " in ice for ", turns, " turns!")
	var manager = get_tree().get_first_node_in_group("battle_manager")
	for i in range(turns):
		manager.delay_actor_turn(target)
	await get_tree().create_timer(0.5).timeout
	emit_signal("turn_finished")


func _ice_shield(ally: BattleActor) -> void:
	party_member.spend_will(SHIELD_WILL_COST)
	ally.apply_status(STATUS_DODGING, SHIELD_DODGE_TURNS)
	print(name, " wraps ", ally.name, " in an ice shield.")
	spend_turn()


func _shiver() -> void:
	if hp <= SHIVER_HP_COST:
		print(name, " is too weak to shiver.")
		spend_turn()
		return
	take_damage(SHIVER_HP_COST)
	apply_status(STATUS_DODGING, SHIVER_DODGE_TURNS)
	print(name, " braces against the cold, ready to dodge.")
	spend_turn()


func _desperate_grasp() -> void:
	if hp <= SELF_HARM_HP_COST:
		print(name, " is too weak to grasp.")
		spend_turn()
		return
	take_damage(SELF_HARM_HP_COST)
	party_member.restore_will(SELF_HARM_WILL_RESTORE)
	print(name, " hurts himself for ", SELF_HARM_HP_COST, " to restore ", SELF_HARM_WILL_RESTORE, " will.")
	spend_turn()


# Encased enemies take reduced damage
func take_damage(amount: int, attacker: BattleActor = null) -> void:
	if has_status("encased"):
		amount = int(amount * ENCASE_DMG_REDUCTION)
	super.take_damage(amount, attacker)
