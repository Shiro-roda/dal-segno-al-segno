[sub_resource type="Resource" id="Resource_nja34"]
script = ExtResource("1_1bdla")
display_name = "Vritra"
description = "An omnivorous serpent who hungers always for their next conflict; they relish in being spited, for little else do they have, are they capable in sharing with their fellow creature. You know them well, and they have seen the end of eternity alongside you. Their war with life is unending, and they wait for your hands alone to deliver their doom."
