[gd_resource type="Resource" script_class="ConditionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Systems/SkillSys/Scripts/ConditionData.gd" id="1_conddata"]

[resource]
script = ExtResource("1_conddata")
condition_id = "bleeding"
display_name = "Bleeding"
