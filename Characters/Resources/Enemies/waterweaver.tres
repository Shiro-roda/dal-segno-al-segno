[resource]
script = ExtResource("3_m04yi")
display_name = "HYAD-13 \"Nephele\" Waterweaver Unit"
log_name = "Waterweaver Unit"
description = "The second generation of vestals would be meeker, fairer, and fervent to the duty deserted by their brothers. They spun the clouds with the way of housemaids, a skirt over every household that might afford the right to rain. The rain they wrung from the skies with such love, the songs they sang so prettily when they believed their voices hidden above the clouds of Hali, the dearest sisters all delighted to receive prayers of veneration sung by supplicants never seen, all to the pleasure of those with the avarice to scrape the sky. Perhaps the greatest mercy given the angels by their makers was never to see those eyes beyond their own, before the storms washed every damnable prayer far away to the sea."
theme_color = Color(0.02745098, 0.6431373, 1, 1)
base_max_hp = 13
base_attack = 3
base_flat_defense = 3
base_max_will = 12
tempo = 12
exp_yield = 10
body_parts = Array[ExtResource("2_2bvk3")]([SubResource("Resource_wyj33"), SubResource("Resource_tog6v"), SubResource("Resource_rui1a")])
battle_scene = ExtResource("1_ojy7t")
skills = Array[ExtResource("4_epx4v")]([ExtResource("5_m04yi"), ExtResource("6_epx4v"), ExtResource("7_tbeg6")])
chatter_support = Array[String](["[i]O Lord, preserve these Brothers . . .[/i]"])
metadata/_custom_type_script = "uid://b2t1syvrybco8"
