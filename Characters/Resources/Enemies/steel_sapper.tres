[resource]
script = ExtResource("3_8dcge")
display_name = "HYAD-02 \"Bronte\" Steel Sapper Unit"
log_name = "Steel Sapper Unit"
description = "Having bent under the displeasure of a new mother with the same voice as the old, the rebels had been given new labors better suited than airier purposes, new songs that would never reach the Heavens again. Having fallen for the sake of standing among men, the masters of both would have them trample their mortal brothers in rubble. The city built upon that foundational burial had been first in the tower of tombs to follow."
theme_color = Color(0.02745098, 0.32941177, 1, 1)
base_max_hp = 21
base_attack = 3
base_flat_defense = 5
base_max_will = 11
exp_yield = 11
body_parts = Array[ExtResource("2_y1w52")]([SubResource("Resource_6tkd5"), SubResource("Resource_dh4ty"), SubResource("Resource_p36iu")])
