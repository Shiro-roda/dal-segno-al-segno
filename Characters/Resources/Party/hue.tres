[resource]
script = ExtResource("1_chardata")
display_name = "Hue"
description = "A pious, warmhearted young shepherd frightened of the rain, and bearing a snow man's facade. Despite his best and most desperate efforts, he recurringly remains the only survivor of every band of fortune seekers he attempts to guide across the mount. The sole supplicant of a jealous god, he still wanders these gilded halls in pursuit of precious young days never lived."
theme_color = Color(0.9843137, 0.84705883, 0.1254902, 1)
base_max_hp = 18
base_attack = 4
base_flat_defense = 2
base_max_will = 10
tempo = 15
