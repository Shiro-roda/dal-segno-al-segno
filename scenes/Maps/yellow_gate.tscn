[sub_resource type="GDScript" id="GDScript_1nwnd"]
script/source = "extends Area3D

@onready var player: CharacterBody3D = %Player
@onready var cry_of_the_red_dragon: AudioStreamPlayer3D = $\"../Cry of the Red Dragon\"
var cried = false




func _on_body_shape_entered(body_rid: RID, body: Node3D, body_shape_index: int, local_shape_index: int) -> void:
	if body == player and cried == false:
		cried = true
		cry_of_the_red_dragon.play()
		
"

