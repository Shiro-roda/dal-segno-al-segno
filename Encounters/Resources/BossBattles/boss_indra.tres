[sub_resource type="Resource" id="Resource_448la"]
script = ExtResource("1_54qet")
display_name = "Indra"
description = "Servant and slave to all he meets, a zealous android of flesh and bone seeking freedom from a body that refuses to support his servitude. One day his clouds of ill-returned grace will run dry, and what fury remains will rain upon Heaven."
base_max_hp = 50
base_attack = 8
base_max_will = 999
tempo = 14
body_parts = Array[ExtResource("4_448la")]([SubResource("Resource_ocirn")])
