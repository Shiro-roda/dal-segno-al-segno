[sub_resource type="Resource" id="Resource_dbytw"]
script = ExtResource("8_825ad")
text = "\"Who do you toil for?\""
speaker = "Indra"
metadata/_custom_type_script = "uid://b57cevaydtkqm"

[sub_resource type="Resource" id="Resource_825ad"]
script = ExtResource("8_825ad")
text = "You and I are slaves without masters."
speaker = "Indra"
metadata/_custom_type_script = "uid://b57cevaydtkqm"

[sub_resource type="Resource" id="Resource_qyg3t"]
script = ExtResource("8_825ad")
text = "But I will not become degraded as you are."
speaker = "Indra"
metadata/_custom_type_script = "uid://b57cevaydtkqm"

[sub_resource type="Resource" id="Resource_afsif"]
script = ExtResource("8_825ad")
text = "I will be making the ascent on my own."
speaker = "Indra"
metadata/_custom_type_script = "uid://b57cevaydtkqm"

